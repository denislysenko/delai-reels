# Keys live here and nowhere else — this file's copy `.env` is gitignored.
# Fill them in yourself; the agent only checks that they work and never prints them.

# ElevenLabs: Scribe transcription, new SFX, voiceover — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# 21st.dev MCP — https://21st.dev/mcp
TWENTYFIRST_API_KEY=

# Публикация в Instagram: Buffer публикует, Dropbox держит ролик по публичной ссылке (SERVICES.md)
# Buffer — https://publish.buffer.com/settings/api
BUFFER_API_KEY=
# канал Instagram в Buffer, если их несколько (python3 scripts/publish_buffer.py channels)
BUFFER_CHANNEL_ID=

# Dropbox — приложение на https://www.dropbox.com/developers/apps (тип App folder)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# код со страницы входа (python3 scripts/publish_dropbox.py login), connect сам заменит его постоянным ключом
DROPBOX_AUTH_CODE=
DROPBOX_REFRESH_TOKEN=
